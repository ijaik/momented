# ==============================================================================
# Momented - Environment Variables Template
# ==============================================================================
# Duplicate this file as .env.local:
#   cp .env.example .env.local
# Fill in the values below before running the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# Site Configuration
# ------------------------------------------------------------------------------
# Canonical URL for your site (e.g. http://localhost:3000 for local dev or your production domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Find these in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# Cloudinary Configuration
# ------------------------------------------------------------------------------
# Find these in your Cloudinary Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# Studio Admin Authentication & Session Security
# ------------------------------------------------------------------------------
# Bcrypt hash of your admin password.
# Generate via Bun: bun -e "console.log(require('bcryptjs').hashSync('your_secure_password', 12))"
ADMIN_PASSWORD_HASH=$2b$12$...

# High-entropy secret string (minimum 32 characters) for signing and verifying admin session JWTs.
# Generate via Bun: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=your-at-least-32-characters-long-high-entropy-secret-key

# ------------------------------------------------------------------------------
# Upstash Redis (Optional for dev, recommended for production)
# ------------------------------------------------------------------------------
# Used for distributed API rate limiting (60 req/hr) and brute-force login lockout.
# If omitted in development, Momented automatically falls back to an in-memory store.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
